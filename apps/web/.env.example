# Supabase — Settings -> API in your Supabase project
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Privy — API Keys page, same app as the mobile client's EXPO_PUBLIC_PRIVY_APP_ID
PRIVY_APP_ID=
# App secret (API Keys page). This is NOT the public client ID below.
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional, public — dashboard's Clients section, same value mobile ships as
# EXPO_PUBLIC_PRIVY_CLIENT_ID.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Public key-quorum ID of the backend authorization key (Dashboard ->
# Wallet infrastructure -> Authorization keys). Powers the automatic
# signing grant new accounts get on first login; private key stays
# server-side.
NEXT_PUBLIC_PRIVY_SIGNER_ID=

# Privy — Authorization keys page. P-256 private key (base64 PKCS8, no PEM
# headers) for the authorization key registered as a signer on this app's
# embedded wallets. Lets the backend sign CLOB auth/orders on a user's
# behalf (balance + trading). Read-only browsing works without it — signing
# then fails with a clear error. See docs/WALLET.md, "Backend Signing".
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# Optional — defaults to the public Polymarket Gamma API
POLYMARKET_GAMMA_BASE_URL=
# Optional — defaults to the public Polymarket Data API, which serves the
# leaderboard ranking GET /leaderboard reads (a different service from Gamma)
POLYMARKET_DATA_BASE_URL=
# Optional — defaults to the public Polymarket CLOB API, which serves the
# price history GET /markets/:id/price-history reads (a different service
# from both Gamma and Data)
POLYMARKET_CLOB_BASE_URL=

# Required for trading: Builder API credentials from
# polymarket.com/settings -> Builder. The official @polymarket/client uses
# them to set up the user's Deposit Wallet (gasless deploy + trading
# approvals) and to place orders. Without them, trading endpoints return
# builder_keys_missing while browsing still works.
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# Financial actions stay disabled until legal and licensing requirements are complete.
NEXT_PUBLIC_TRADING_ENABLED=false
TRADING_ENABLED=false
