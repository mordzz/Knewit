# Server-side env vars for the API routes under src/routes/api (mirrored
# from apps/backend/.env.example — see apps/backend/src/lib/env.ts for how
# each one is read). Not VITE_-prefixed on purpose: they must never reach
# the client bundle.

# Supabase — Settings -> API in your Supabase project
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Privy — API Keys page
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Privy — Authorization keys page. P-256 private key (base64 PKCS8, no PEM
# headers) for the authorization key registered as a signer on this app's
# embedded wallets. Lets the backend sign CLOB auth/orders on a user's
# behalf. Read-only browsing works without it — signing then fails with a
# clear error.
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# Optional — defaults to the public Polymarket Gamma API
POLYMARKET_GAMMA_BASE_URL=
# Optional — defaults to the public Polymarket Data API (leaderboard)
POLYMARKET_DATA_BASE_URL=
# Optional — defaults to the public Polymarket CLOB API (price history)
POLYMARKET_CLOB_BASE_URL=

# Required for trading: Builder API credentials from
# polymarket.com/settings -> Builder.
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=
