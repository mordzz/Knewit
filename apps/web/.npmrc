# npm's strict peer resolution fails here: @polymarket/client@0.10 declares
# a stale `peerOptional` range for @privy-io/node (^0.15.0) while this app
# runs the 0.34.x line, which is what the live-verified signing/trading
# flow was built against. @privy-io/react-auth's wallet-connector tree also
# conflicts with @polymarket/client's viem/ox versions.
#
# `legacy-peer-deps` makes installs (local clones and Vercel, which reads
# this file from the project root) resolve like npm 6 instead of failing
# with ERESOLVE. Keep this file next to package.json.
legacy-peer-deps=true
