# npm's strict peer resolution fails here: @polymarket/client@0.10 declares
# a stale `peerOptional` range for @privy-io/node (^0.15.0) while this app
# runs the 0.34.x line, matching apps/backend (see its own .npmrc, which
# this mirrors — the API routes under src/routes/api are copied straight
# from that backend and share its dependency set).
#
# `legacy-peer-deps` makes installs (local clones and hosting platforms
# that read this file from the project root) resolve like npm 6 instead of
# failing with ERESOLVE. Keep this file next to package.json.
legacy-peer-deps=true
