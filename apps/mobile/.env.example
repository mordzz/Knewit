# Copy to .env and fill in values for local development.
# Only EXPO_PUBLIC_* variables are ever bundled into the app — never put
# secrets (API keys, Polymarket credentials, signing keys) here. Secrets
# live on the backend only. See docs/WALLET.md and docs/API.md.

# Base URL of our backend (BFF). The app talks to this, never to
# Polymarket or Privy's server APIs directly.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Privy client-side app ID (public identifier, safe to ship in the app).
# Privy's secret API key stays on the backend only.
EXPO_PUBLIC_PRIVY_APP_ID=

# Privy client ID (optional per Privy's own SDK — found in the Privy
# dashboard's "Clients" section for your app). Also public/safe to ship.
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Public key-quorum ID of the backend authorization key (Dashboard ->
# Wallet infrastructure -> Authorization keys). Powers the Wallet screen's
# one-time "Enable trading" button; private key stays server-side.
EXPO_PUBLIC_PRIVY_SIGNER_ID=

# Financial actions stay disabled until legal and licensing requirements are complete.
# Public Polygon RPC for Privy's client-side reads (default: publicnode).
EXPO_PUBLIC_POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
EXPO_PUBLIC_TRADING_ENABLED=false
