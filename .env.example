# Copy to .env and fill in values for local development.
# Only EXPO_PUBLIC_* variables are ever bundled into the app — never put
# secrets (API keys, Polymarket credentials, signing keys) here. Secrets
# live on the backend only. See docs/WALLET.md and docs/API.md.

# Base URL of our backend (BFF). The app talks to this, never to
# Polymarket or Privy's server APIs directly.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Privy client-side app ID (public identifier, safe to ship in the app).
# Privy's secret API key stays on the backend only.
EXPO_PUBLIC_PRIVY_APP_ID=
